<Window x:Class="ProjectKino.ZatratyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Затраты" Height="500" Width="950">
    <Grid>
        <!-- Фильтры -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="20,20,0,0" VerticalAlignment="Top">
            <Label Content="Проект:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CBFilterProject" Width="150" Margin="5,0,15,0" DisplayMemberPath="Название" SelectedValuePath="КодПроекта"/>

            <Label Content="Тип затраты:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CBFilterType" Width="150" Margin="5,0,15,0">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Зарплаты"/>
                <ComboBoxItem Content="Аренда"/>
                <ComboBoxItem Content="Оборудование"/>
                <ComboBoxItem Content="Постобработка"/>
            </ComboBox>

            <Button x:Name="ButtonFilter" Content="Найти" Width="80" Height="24" Click="ButtonFilter_Click"/>
            <Button x:Name="ButtonReset" Content="Сброс" Width="80" Height="24" Margin="10,0,0,0" Click="ButtonReset_Click"/>
        </StackPanel>

        <!-- Таблица -->
        <DataGrid x:Name="ZatratyList" Margin="20,70,20,70" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Проект" Binding="{Binding Название}" Width="200"/>
                <DataGridTextColumn Header="Зарплаты" Binding="{Binding ЗатратыNavigation.Зарплаты, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Аренда" Binding="{Binding ЗатратыNavigation.Аренда, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Оборудование" Binding="{Binding ЗатратыNavigation.Оборудование, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Постобработка" Binding="{Binding ЗатратыNavigation.Постобработка, StringFormat={}{0:C}}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding ЗатратыNavigation.Дата}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="AddButton" Content="Добавить затрату" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" Height="30" Width="200" Click="AddButton_Click"/>
        <Button x:Name="ButtonBack" Content="Назад" HorizontalAlignment="Left" Margin="20,434,0,0" VerticalAlignment="Top" Height="30" Width="125" Click="ButtonBack_Click"/>
    </Grid>
</Window>