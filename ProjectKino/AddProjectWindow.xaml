<Window x:Class="ProjectKino.AddProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectKino"
        mc:Ignorable="d"
        Title="AddProjectWindow" Height="475" Width="291">
    <Grid>
        <Label Content="Добавление проекта" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontSize="20" FontWeight="Bold"/>
        <TextBox x:Name="TBName" HorizontalAlignment="Left" Margin="26,71,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242"/>
        <ComboBox x:Name="CBGenre" HorizontalAlignment="Left" Margin="26,114,0,0" VerticalAlignment="Top" Width="242" DisplayMemberPath="Наименование" SelectedValuePath="КодЖанра"/>
        <TextBox x:Name="TBBank" HorizontalAlignment="Left" Margin="27,162,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="241"/>
        <DatePicker x:Name="DataStartBlock" HorizontalAlignment="Left" Margin="26,208,0,0" VerticalAlignment="Top" Width="242"/>
        <DatePicker x:Name="DataFinishBlock" HorizontalAlignment="Left" Margin="27,259,0,0" VerticalAlignment="Top" Width="241"/>
        <ComboBox x:Name="CBSatus" HorizontalAlignment="Left" Margin="28,311,0,0" VerticalAlignment="Top" Width="240" DisplayMemberPath="Наименование" SelectedValuePath="КодСтатуса"/>
        <ComboBox x:Name="CBAuditoriya" HorizontalAlignment="Left" Margin="28,360,0,0" VerticalAlignment="Top" Width="240" DisplayMemberPath="Наименование" SelectedValuePath="КодЦелевойАудитории"/>
        <Label Content="Название фильма" HorizontalAlignment="Left" Margin="26,45,0,0" VerticalAlignment="Top"/>
        <Label Content="Жанр" HorizontalAlignment="Left" Margin="26,89,0,0" VerticalAlignment="Top"/>
        <Label Content="Бюджет" HorizontalAlignment="Left" Margin="26,136,0,0" VerticalAlignment="Top"/>
        <Label Content="Дата начала съёмок" HorizontalAlignment="Left" Margin="26,181,0,0" VerticalAlignment="Top"/>
        <Label Content="Дата окончания съёмок" HorizontalAlignment="Left" Margin="26,232,0,0" VerticalAlignment="Top"/>
        <Label Content="Статус" HorizontalAlignment="Left" Margin="30,283,0,0" VerticalAlignment="Top"/>
        <Label Content="Целевая аудитория" HorizontalAlignment="Left" Margin="28,333,0,0" VerticalAlignment="Top"/>
        <Button Content="Добавить" HorizontalAlignment="Center" Margin="0,399,0,0" VerticalAlignment="Top" Height="32" Width="102" Click="Button_Click"/>

    </Grid>
</Window>
