<Window x:Class="ProjectKino.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectKino"
        mc:Ignorable="d"
        Title="ProjectWindow" Height="476" Width="746">
    <Grid>
        <DataGrid x:Name="ListProject" AutoGenerateColumns="False" Margin="24,0,24,94">
            <DataGrid.Columns >
                <DataGridTextColumn Header="Код проекта" Binding="{Binding КодПроекта}"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Название}"/>
                <DataGridTextColumn Header="Жанр" Binding="{Binding ЖанрNavigation.Наименование}"/>
                <DataGridTextColumn Header="Бюджет" Binding="{Binding Бюджет}"/>
                <DataGridTextColumn Header="Дата начала съёмок" Binding="{Binding ДатаНачалаСъёмок}"/>
                <DataGridTextColumn Header="Дата окончания съёмок"  Binding="{Binding ДатаОкончанияСъёмок}"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding СтатусNavigation.Наименование}"/>
                <DataGridTextColumn Header="Целевая аудитория" Binding="{Binding ЦелеваяАудиторияNavigation.Наименование}"/>

            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="ButtonAddProject" Content="Добавить проект" HorizontalAlignment="Left" Margin="140,382,0,0" VerticalAlignment="Top" Height="38" Width="151" Click="ButtonAddProject_Click"/>
        <Button x:Name="ButtonFiltr" Content="Фильтровать по статусу" HorizontalAlignment="Left" Margin="329,381,0,0" VerticalAlignment="Top" Height="38" Width="152" Click="ButtonFiltr_Click"/>
        <ComboBox x:Name="CBFiltr" HorizontalAlignment="Left" Margin="532,389,0,0" VerticalAlignment="Top" Width="138" Height="20" 
          DisplayMemberPath="Наименование" 
          SelectedValuePath="КодСтатуса"/>
        <Button x:Name="ButtonBack" Content="Назад" HorizontalAlignment="Left" Margin="24,382,0,0" VerticalAlignment="Top" Height="37" Width="74" Click="ButtonBack_Click"/>
    </Grid>
</Window>
