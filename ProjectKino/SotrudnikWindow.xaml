<Window x:Class="ProjectKino.SotrudnikWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectKino"
        mc:Ignorable="d"
        Title="Сотрудники" Height="500" Width="1050">

    <Window.Resources>
        <local:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Таблица со списком сотрудников -->
        <DataGrid x:Name="ListPolzovatels" AutoGenerateColumns="False" Margin="20,80,20,70" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Табельный номер" Binding="{Binding ТабельныйНомер}" Width="110"/>

                <!-- Колонка с фотографией -->
                <DataGridTemplateColumn Header="Фото" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Source="{Binding Фото, Converter={StaticResource ImagePathConverter}}" 
                                   Width="70" Height="70" Stretch="Uniform"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Фамилия" Binding="{Binding Фамилия}" Width="120"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding Имя}" Width="120"/>
                <DataGridTextColumn Header="Специализация" Binding="{Binding СпециализацияNavigation.Наименование}" Width="130"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding КонтактныеДанныеNavigation.Телефон}" Width="110"/>
                <DataGridTextColumn Header="Почта" Binding="{Binding КонтактныеДанныеNavigation.Почта}" Width="150"/>
                <DataGridTextColumn Header="Ставка" Binding="{Binding Ставка}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Заголовок -->
        <Label Content="Список сотрудников" HorizontalAlignment="Left" Margin="20,15,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20"/>

        <!-- Панель поиска -->
        <Label Content="Поиск по фамилии:" HorizontalAlignment="Left" Margin="20,50,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBSearch" HorizontalAlignment="Left" Margin="150,53,0,0" VerticalAlignment="Top" Width="150"/>
        <Button x:Name="ButtonSearch" Content="Найти" HorizontalAlignment="Left" Margin="310,51,0,0" VerticalAlignment="Top" Width="80" Height="24" Click="ButtonSearch_Click"/>

        <!-- Кнопки управления -->
        <Button x:Name="ButtonAdd" Content="Добавить" HorizontalAlignment="Left" Margin="214,0,0,20" VerticalAlignment="Bottom" Width="120" Height="30" Click="ButtonAdd_Click"/>
        <Button x:Name="ButtonChange" Content="Редактировать" HorizontalAlignment="Left" Margin="344,0,0,20" VerticalAlignment="Bottom" Width="120" Height="30" Click="ButtonChange_Click"/>
        <Button x:Name="ButtonDelete" Content="Удалить" HorizontalAlignment="Left" Margin="474,0,0,20" VerticalAlignment="Bottom" Width="120" Height="30" Click="ButtonDelete_Click"/>
        <Button x:Name="ButtonBack" Content="Назад" HorizontalAlignment="Left" Margin="20,434,0,0" VerticalAlignment="Top" Height="30" Width="125" Click="ButtonBack_Click"/>
    </Grid>
</Window>