<Window x:Class="ProjectKino.MainMunu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectKino"
        mc:Ignorable="d"
        Title="MainMunu" Height="450" Width="800">
    <Grid>
        <Button x:Name="ButtonSotrudniki" Content="Сотрудники" HorizontalAlignment="Left" Margin="227,116,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonSotrudniki_Click"/>
        <Button x:Name="ButtonProject" Content="Проекты" HorizontalAlignment="Left" Margin="227,163,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonProject_Click"/>
        <Button x:Name="ButtonPloshadka" Content="Площадки" HorizontalAlignment="Left" Margin="313,266,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonPloshadka_Click"/>
        <Button x:Name="ButtonGruppa" Content="Съёмочная группа" HorizontalAlignment="Left" Margin="227,217,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonGruppa_Click"/>
        <Button x:Name="ButtonGrafik" Content="График съёмок" HorizontalAlignment="Left" Margin="400,116,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonGrafik_Click"/>
        <Button x:Name="ButtonZatrat" Content="Затраты" HorizontalAlignment="Left" Margin="400,158,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonZatrat_Click"/>
        <Button x:Name="ButtonProkat" Content="Прокат" HorizontalAlignment="Left" Margin="400,217,0,0" VerticalAlignment="Top" Width="119" Height="33" Click="ButtonProkat_Click"/>
        <TextBlock x:Name="TBUserName" HorizontalAlignment="Left" Margin="10,10,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="119" Height="33"/>
        <Button x:Name="ButtonBack" Content="Выйти" HorizontalAlignment="Left" Margin="20,395,0,0" VerticalAlignment="Top" Click="ButtonBack_Click" Width="119" Height="33"/>

    </Grid>
</Window>
