<Window x:Class="ProjectKino.AddPloshadkaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectKino"
        mc:Ignorable="d"
        Title="AddPloshadkaWindow" Height="450" Width="291">
    <Grid>
        <Label Content="Добавление площадки" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20"/>
        <TextBox x:Name="TBAdres" HorizontalAlignment="Center" Margin="0,78,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="237"/>
        <ComboBox x:Name="CBType" HorizontalAlignment="Center" Margin="0,137,0,0" VerticalAlignment="Top" Width="237" DisplayMemberPath="Наименование" SelectedValuePath="КодТипаПлощаки"/>
        <TextBox x:Name="TBPrice" HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="237"/>
        <TextBox x:Name="TBMesto" HorizontalAlignment="Center" Margin="0,278,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="237"/>
        <Label Content="Адрес" HorizontalAlignment="Left" Margin="27,52,0,0" VerticalAlignment="Top"/>
        <Label Content="Тип" HorizontalAlignment="Left" Margin="27,111,0,0" VerticalAlignment="Top"/>
        <Label Content="Стоимость аренды в день" HorizontalAlignment="Left" Margin="27,190,0,0" VerticalAlignment="Top"/>
        <Label Content="Вместимость" HorizontalAlignment="Left" Margin="27,252,0,0" VerticalAlignment="Top"/>
        <Button x:Name="AddButton" Content="Добавить" HorizontalAlignment="Center" Margin="0,344,0,0" VerticalAlignment="Top" Height="30" Width="108" Click="AddButton_Click"/>

    </Grid>
</Window>
