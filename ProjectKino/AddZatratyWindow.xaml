<Window x:Class="ProjectKino.AddZatratyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление затраты" Height="400" Width="350">
    <Grid>
        <Label Content="Новая затрата" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="16"/>

        <Label Content="Проект:" HorizontalAlignment="Left" Margin="30,50,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="CBProject" HorizontalAlignment="Left" Margin="30,75,0,0" VerticalAlignment="Top" Width="270" DisplayMemberPath="Название" SelectedValuePath="КодПроекта"/>

        <Label Content="Тип затраты:" HorizontalAlignment="Left" Margin="30,110,0,0" VerticalAlignment="Top"/>
        <ComboBox x:Name="CBType" HorizontalAlignment="Left" Margin="30,135,0,0" VerticalAlignment="Top" Width="270">
            <ComboBoxItem Content="Зарплаты"/>
            <ComboBoxItem Content="Аренда"/>
            <ComboBoxItem Content="Оборудование"/>
            <ComboBoxItem Content="Постобработка"/>
        </ComboBox>

        <Label Content="Сумма:" HorizontalAlignment="Left" Margin="30,170,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBSum" HorizontalAlignment="Left" Margin="30,195,0,0" VerticalAlignment="Top" Width="270"/>

        <Label Content="Дата:" HorizontalAlignment="Left" Margin="30,230,0,0" VerticalAlignment="Top"/>
        <DatePicker x:Name="DPDate" HorizontalAlignment="Left" Margin="30,255,0,0" VerticalAlignment="Top" Width="270"/>

        <Button x:Name="ButtonSave" Content="Сохранить" HorizontalAlignment="Left" Margin="30,310,0,0" VerticalAlignment="Top" Width="270" Height="30" Click="ButtonSave_Click"/>
    </Grid>
</Window>