<Window x:Class="ProjectKino.ChangeSotrudnikWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjectKino"
        mc:Ignorable="d"
        Title="ChangeSotrudnikWindow" Height="694" Width="283">
    <Grid Margin="0,0,0,-16">
        <Label Content="Изменение сотрудника" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="18"/>
        <Label Content="Фамилия" HorizontalAlignment="Left" Margin="17,181,0,0" VerticalAlignment="Top"/>
        <Label Content="Имя" HorizontalAlignment="Left" Margin="22,218,0,0" VerticalAlignment="Top"/>
        <Label Content="Специализация" HorizontalAlignment="Left" Margin="19,365,0,0" VerticalAlignment="Top"/>
        <Label Content="Телефон" HorizontalAlignment="Left" Margin="18,423,0,0" VerticalAlignment="Top"/>
        <Label Content="Email" HorizontalAlignment="Left" Margin="19,471,0,0" VerticalAlignment="Top"/>
        <Label Content="Ставка" HorizontalAlignment="Left" Margin="24,523,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBSurname" HorizontalAlignment="Left" Margin="13,207,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242"/>
        <TextBox x:Name="TBName" HorizontalAlignment="Left" Margin="10,243,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242"/>
        <TextBox x:Name="TBPhone" HorizontalAlignment="Left" Margin="19,448,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242"/>
        <TextBox x:Name="TBEmail" HorizontalAlignment="Left" Margin="19,500,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242"/>
        <TextBox x:Name="TBStavka" HorizontalAlignment="Left" Margin="19,549,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242"/>
        <Button x:Name="ButtonAdd" Content="Изменить" HorizontalAlignment="Left" Margin="93,586,0,0" VerticalAlignment="Top" Height="25" Width="77" Click="Button_Click"/>
        <Label Content="Логин" HorizontalAlignment="Left" Margin="17,272,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBLogin" HorizontalAlignment="Left" Margin="13,298,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="239"/>
        <Label Content="Пароль" HorizontalAlignment="Left" Margin="15,320,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="TBPassword" HorizontalAlignment="Left" Margin="10,347,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="242" >

        </TextBox>
        <ComboBox x:Name="CBSpecialization" HorizontalAlignment="Left" Margin="18,396,0,0" VerticalAlignment="Top" Width="239" DisplayMemberPath="Наименование" SelectedValuePath="КодСпециализации"/>
        <Image x:Name="ImgPreview" HorizontalAlignment="Left" Margin="17,45,0,0" VerticalAlignment="Top" Width="100" Height="100" Stretch="Uniform"/>
        <Button x:Name="ButtonLoadPhoto" Content="Загрузить фото" HorizontalAlignment="Left" Margin="135,45,0,0" VerticalAlignment="Top" Width="130" Height="30" Click="ButtonLoadPhoto_Click"/>
        <TextBox x:Name="TBPhotoPath" HorizontalAlignment="Left" Margin="132,95,0,0" VerticalAlignment="Top" Width="130" Visibility="Collapsed"/>
    </Grid>
</Window>
